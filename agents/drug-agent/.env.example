# Copy to .env and set values for your installation. Keep credentials private.
DRUGAGENT_PROFILE=local
DRUGAGENT_DETERMINISTIC=1
DRUGAGENT_HOME=./.drugagent
DRUGAGENT_ALLOW_NETWORK=0
DRUGAGENT_EGRESS_ALLOWLIST=ebi.ac.uk,rcsb.org

# Optional local reasoning backend; install Ollama and pull the model separately.
# LLM_AGENT_MODEL=qwen3.8:27b
# LLM_AGENT_OLLAMA_HOST=http://127.0.0.1:11434
# LLM_AGENT_MAX_CYCLES=3
# LLM_AGENT_REFINE_STRATEGY=adaptive
# LLM_AGENT_STRUCTURED=auto
# LLM_AGENT_THINK=1
# LLM_AGENT_PORT=2003

# New task executions can create local experience for the Self-Evolve Agent.
# No historical request journals are included in this release.
# LLM_AGENT_JOURNAL=1
# DRUGAGENT_JOURNAL_DIR=./running-history

# Self-evolution roles and budgets are configured in configs/self_evolve.yaml.
# DRUGAGENT_EVOLVE_DEEP_MODEL=opus
# DRUGAGENT_EVOLVE_CRITIC_MODEL=sonnet
# DRUGAGENT_EVOLVE_AUTO_PROMOTE=0

# Optional PFM adapter: ./install.sh pfm; ./install.sh pfm-source
# The default checkout .external/PFM is discovered automatically.
# Override these only for resources installed elsewhere.
# DRUGAGENT_PFM_ROOT=
# DRUGAGENT_PFM_PYTHON=
# DRUGAGENT_PFM_CHECKPOINT=
# DRUGAGENT_PFM_TRAINING_YML=
# DRUGAGENT_PFM_X_PREDICTOR=
# DRUGAGENT_PFM_H_PREDICTOR=
# DRUGAGENT_PFM_DEVICE=cuda:0
# DRUGAGENT_PFM_TIMEOUT_SECONDS=1800
# Prepare a pocket with scripts/prepare_pocket.py before setting its path.
# DRUGAGENT_PFM_POCKET=

# Optional distributed-backend seams; the public default is local execution.
# DRUGAGENT_DB_URL=
# DRUGAGENT_OTLP_ENDPOINT=
