{
  "$defs": {
    "ApplicabilityDomain": {
      "enum": [
        "IN_DOMAIN",
        "BORDERLINE",
        "OUT_OF_DOMAIN",
        "UNKNOWN"
      ],
      "title": "ApplicabilityDomain",
      "type": "string"
    },
    "SafetyEndpoint": {
      "additionalProperties": false,
      "description": "One toxicity/safety endpoint result.",
      "properties": {
        "alerts": {
          "items": {
            "type": "string"
          },
          "title": "Alerts",
          "type": "array"
        },
        "applicability": {
          "$ref": "#/$defs/ApplicabilityDomain",
          "default": "UNKNOWN"
        },
        "calibrated": {
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "endpoint": {
          "description": "e.g. 'hERG', 'AMES', 'hepatotox', 'structural_alerts'.",
          "title": "Endpoint",
          "type": "string"
        },
        "ext": {
          "additionalProperties": true,
          "description": "Explicit namespace for non-critical extension fields.",
          "title": "Ext",
          "type": "object"
        },
        "flag": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Binary alert if applicable.",
          "title": "Flag"
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "model_id": {
          "default": "",
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "default": "0.0.0",
          "title": "Model Version",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version.",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Probability/severity score if numeric.",
          "title": "Score"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "NONE"
        }
      },
      "required": [
        "endpoint"
      ],
      "title": "SafetyEndpoint",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "NONE",
        "LOW",
        "MODERATE",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate safety profile that preserves per-endpoint detail.\n\nDeliberately distinguishes \"no detected signal\" from \"safe\": ``no_signal``\nmeans the panel found nothing, never a safety claim.",
  "properties": {
    "candidate_id": {
      "default": "",
      "title": "Candidate Id",
      "type": "string"
    },
    "created_at": {
      "description": "ISO-8601 UTC creation time.",
      "title": "Created At",
      "type": "string"
    },
    "disclaimer": {
      "default": "No detected signal is not a claim of safety. External in-vitro/in-vivo validation is required before any safety conclusion.",
      "title": "Disclaimer",
      "type": "string"
    },
    "endpoints": {
      "items": {
        "$ref": "#/$defs/SafetyEndpoint"
      },
      "title": "Endpoints",
      "type": "array"
    },
    "ext": {
      "additionalProperties": true,
      "description": "Explicit namespace for non-critical extension fields.",
      "title": "Ext",
      "type": "object"
    },
    "id": {
      "default": "",
      "description": "Stable prefixed identifier.",
      "title": "Id",
      "type": "string"
    },
    "id_prefix": {
      "default": "safety",
      "title": "Id Prefix",
      "type": "string"
    },
    "max_severity": {
      "$ref": "#/$defs/Severity",
      "default": "NONE"
    },
    "n_flags": {
      "default": 0,
      "title": "N Flags",
      "type": "integer"
    },
    "no_signal": {
      "default": false,
      "title": "No Signal",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Contract schema version.",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    }
  },
  "title": "SafetyProfile",
  "type": "object"
}