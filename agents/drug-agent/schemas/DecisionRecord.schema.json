{
  "$defs": {
    "DecisionOutcome": {
      "enum": [
        "PROMOTE",
        "REJECT",
        "DEFER"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A lightweight pointer to a full EvidenceItem (see contracts.evidence).",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "ext": {
          "additionalProperties": true,
          "description": "Explicit namespace for non-critical extension fields.",
          "title": "Ext",
          "type": "object"
        },
        "relation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How it relates, e.g. 'supports'.",
          "title": "Relation"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version.",
          "title": "Schema Version",
          "type": "string"
        },
        "trust_label": {
          "$ref": "#/$defs/TrustLabel",
          "default": "CURATED"
        }
      },
      "required": [
        "evidence_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "TrustLabel": {
      "description": "Epistemic provenance of a value. Every scientific number carries one.",
      "enum": [
        "OBSERVED",
        "CURATED",
        "CALCULATED",
        "PREDICTED",
        "INFERRED",
        "HYPOTHESIZED",
        "PROPOSED"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An auditable decision (promote/reject/defer) with reasons and inputs.",
  "properties": {
    "created_at": {
      "description": "ISO-8601 UTC creation time.",
      "title": "Created At",
      "type": "string"
    },
    "decided_by": {
      "default": "system",
      "description": "Agent/human that decided.",
      "title": "Decided By",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "ext": {
      "additionalProperties": true,
      "description": "Explicit namespace for non-critical extension fields.",
      "title": "Ext",
      "type": "object"
    },
    "id": {
      "default": "",
      "description": "Stable prefixed identifier.",
      "title": "Id",
      "type": "string"
    },
    "id_prefix": {
      "default": "dec",
      "title": "Id Prefix",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "outcome": {
      "$ref": "#/$defs/DecisionOutcome"
    },
    "policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Contract schema version.",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "description": "Candidate/entity the decision is about.",
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "subject_id",
    "outcome",
    "rationale"
  ],
  "title": "DecisionRecord",
  "type": "object"
}