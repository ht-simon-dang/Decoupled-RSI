{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a value/object came from and how to reproduce it.",
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Content hash of the source data.",
          "title": "Content Hash"
        },
        "ext": {
          "additionalProperties": true,
          "description": "Explicit namespace for non-critical extension fields.",
          "title": "Ext",
          "type": "object"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Capability/algorithm that produced it.",
          "title": "Method"
        },
        "method_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Version"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version.",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data snapshot identifier.",
          "title": "Snapshot Id"
        },
        "source": {
          "description": "Human/system origin, e.g. 'rdkit', 'chembl_fixture'.",
          "title": "Source",
          "type": "string"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version of the source.",
          "title": "Source Version"
        },
        "trust_label": {
          "$ref": "#/$defs/TrustLabel",
          "default": "CALCULATED"
        }
      },
      "required": [
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TrustLabel": {
      "description": "Epistemic provenance of a value. Every scientific number carries one.",
      "enum": [
        "OBSERVED",
        "CURATED",
        "CALCULATED",
        "PREDICTED",
        "INFERRED",
        "HYPOTHESIZED",
        "PROPOSED"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Receptor structure + preparation metadata.",
  "properties": {
    "accession": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accession"
    },
    "construct_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Construct/boundaries used.",
      "title": "Construct Label"
    },
    "coverage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage"
    },
    "created_at": {
      "description": "ISO-8601 UTC creation time.",
      "title": "Created At",
      "type": "string"
    },
    "ext": {
      "additionalProperties": true,
      "description": "Explicit namespace for non-critical extension fields.",
      "title": "Ext",
      "type": "object"
    },
    "id": {
      "default": "",
      "description": "Stable prefixed identifier.",
      "title": "Id",
      "type": "string"
    },
    "id_prefix": {
      "default": "prot",
      "title": "Id Prefix",
      "type": "string"
    },
    "isoform": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Isoform"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "X-ray/cryo-EM/model.",
      "title": "Method"
    },
    "mutations": {
      "items": {
        "type": "string"
      },
      "title": "Mutations",
      "type": "array"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "pdb_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdb Id"
    },
    "preparation_assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Preparation Assumptions",
      "type": "array"
    },
    "prepared": {
      "default": false,
      "title": "Prepared",
      "type": "boolean"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Notes"
    },
    "resolution": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Contract schema version.",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_checksum": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sequence Checksum"
    },
    "structure_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Artifact ref to coordinates.",
      "title": "Structure Ref"
    }
  },
  "title": "ProteinStructure",
  "type": "object"
}