{
  "$defs": {
    "ApplicabilityDomain": {
      "enum": [
        "IN_DOMAIN",
        "BORDERLINE",
        "OUT_OF_DOMAIN",
        "UNKNOWN"
      ],
      "title": "ApplicabilityDomain",
      "type": "string"
    },
    "DecisionOutcome": {
      "enum": [
        "PROMOTE",
        "REJECT",
        "DEFER"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "EndpointScore": {
      "additionalProperties": false,
      "description": "Per-endpoint entry on a candidate scorecard.",
      "properties": {
        "applicability": {
          "$ref": "#/$defs/ApplicabilityDomain",
          "default": "UNKNOWN"
        },
        "direction": {
          "default": "maximize",
          "title": "Direction",
          "type": "string"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "ext": {
          "additionalProperties": true,
          "description": "Explicit namespace for non-critical extension fields.",
          "title": "Ext",
          "type": "object"
        },
        "missing": {
          "default": false,
          "title": "Missing",
          "type": "boolean"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "normalized": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0..1, higher = better.",
          "title": "Normalized"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version.",
          "title": "Schema Version",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "endpoint"
      ],
      "title": "EndpointScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A full, auditable scorecard for one candidate (acceptance criterion #10, \u00a710).",
  "properties": {
    "candidate_id": {
      "default": "",
      "title": "Candidate Id",
      "type": "string"
    },
    "canonical_smiles": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Smiles"
    },
    "conflict_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conflict Score"
    },
    "created_at": {
      "description": "ISO-8601 UTC creation time.",
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/DecisionOutcome",
      "default": "DEFER"
    },
    "decision_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Decision Reasons",
      "type": "array"
    },
    "diversity_cluster": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diversity Cluster"
    },
    "endpoints": {
      "items": {
        "$ref": "#/$defs/EndpointScore"
      },
      "title": "Endpoints",
      "type": "array"
    },
    "evidence_quality": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Quality"
    },
    "ext": {
      "additionalProperties": true,
      "description": "Explicit namespace for non-critical extension fields.",
      "title": "Ext",
      "type": "object"
    },
    "hard_constraint_outcomes": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Hard Constraint Outcomes",
      "type": "object"
    },
    "hard_constraints_passed": {
      "default": true,
      "title": "Hard Constraints Passed",
      "type": "boolean"
    },
    "id": {
      "default": "",
      "description": "Stable prefixed identifier.",
      "title": "Id",
      "type": "string"
    },
    "id_prefix": {
      "default": "score",
      "title": "Id Prefix",
      "type": "string"
    },
    "inchikey": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inchikey"
    },
    "out_of_domain_penalty": {
      "default": 0.0,
      "title": "Out Of Domain Penalty",
      "type": "number"
    },
    "pareto_optimal": {
      "default": false,
      "title": "Pareto Optimal",
      "type": "boolean"
    },
    "pareto_rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pareto Rank"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Contract schema version.",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "utility": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional display-only scalar utility.",
      "title": "Utility"
    }
  },
  "title": "Scorecard",
  "type": "object"
}