{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A lightweight pointer to a full EvidenceItem (see contracts.evidence).",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "ext": {
          "additionalProperties": true,
          "description": "Explicit namespace for non-critical extension fields.",
          "title": "Ext",
          "type": "object"
        },
        "relation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How it relates, e.g. 'supports'.",
          "title": "Relation"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version.",
          "title": "Schema Version",
          "type": "string"
        },
        "trust_label": {
          "$ref": "#/$defs/TrustLabel",
          "default": "CURATED"
        }
      },
      "required": [
        "evidence_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "TrustLabel": {
      "description": "Epistemic provenance of a value. Every scientific number carries one.",
      "enum": [
        "OBSERVED",
        "CURATED",
        "CALCULATED",
        "PREDICTED",
        "INFERRED",
        "HYPOTHESIZED",
        "PROPOSED"
      ],
      "title": "TrustLabel",
      "type": "string"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "ext": {
          "additionalProperties": true,
          "description": "Explicit namespace for non-critical extension fields.",
          "title": "Ext",
          "type": "object"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version.",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "description": "'error' | 'warning' | 'info'.",
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The typed result an agent returns. Payload is schema-validated per action.",
  "properties": {
    "action": {
      "default": "",
      "title": "Action",
      "type": "string"
    },
    "agent_id": {
      "default": "",
      "title": "Agent Id",
      "type": "string"
    },
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "created_at": {
      "description": "ISO-8601 UTC creation time.",
      "title": "Created At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "explanation": {
      "default": "",
      "title": "Explanation",
      "type": "string"
    },
    "ext": {
      "additionalProperties": true,
      "description": "Explicit namespace for non-critical extension fields.",
      "title": "Ext",
      "type": "object"
    },
    "external_calls": {
      "default": 0,
      "title": "External Calls",
      "type": "integer"
    },
    "id": {
      "default": "",
      "description": "Stable prefixed identifier.",
      "title": "Id",
      "type": "string"
    },
    "id_prefix": {
      "default": "ares",
      "title": "Id Prefix",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "request_id": {
      "default": "",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Contract schema version.",
      "title": "Schema Version",
      "type": "string"
    },
    "seconds_used": {
      "default": 0.0,
      "title": "Seconds Used",
      "type": "number"
    },
    "status": {
      "default": "ok",
      "description": "'ok' | 'partial' | 'error'.",
      "title": "Status",
      "type": "string"
    },
    "tokens_used": {
      "default": 0,
      "title": "Tokens Used",
      "type": "integer"
    },
    "validation_issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Validation Issues",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "AgentResult",
  "type": "object"
}