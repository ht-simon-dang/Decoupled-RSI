{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A lightweight pointer to a full EvidenceItem (see contracts.evidence).",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "ext": {
          "additionalProperties": true,
          "description": "Explicit namespace for non-critical extension fields.",
          "title": "Ext",
          "type": "object"
        },
        "relation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How it relates, e.g. 'supports'.",
          "title": "Relation"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version.",
          "title": "Schema Version",
          "type": "string"
        },
        "trust_label": {
          "$ref": "#/$defs/TrustLabel",
          "default": "CURATED"
        }
      },
      "required": [
        "evidence_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "TrustLabel": {
      "description": "Epistemic provenance of a value. Every scientific number carries one.",
      "enum": [
        "OBSERVED",
        "CURATED",
        "CALCULATED",
        "PREDICTED",
        "INFERRED",
        "HYPOTHESIZED",
        "PROPOSED"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A proposed next experiment to reduce uncertainty on a candidate.",
  "properties": {
    "assay_type": {
      "description": "e.g. 'biochemical_IC50', 'hERG_patch', 'ADME_microsomal'.",
      "title": "Assay Type",
      "type": "string"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "created_at": {
      "description": "ISO-8601 UTC creation time.",
      "title": "Created At",
      "type": "string"
    },
    "est_cost_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Est Cost Class"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "expected_information_gain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Information Gain"
    },
    "ext": {
      "additionalProperties": true,
      "description": "Explicit namespace for non-critical extension fields.",
      "title": "Ext",
      "type": "object"
    },
    "hypothesis": {
      "default": "",
      "title": "Hypothesis",
      "type": "string"
    },
    "id": {
      "default": "",
      "description": "Stable prefixed identifier.",
      "title": "Id",
      "type": "string"
    },
    "id_prefix": {
      "default": "exp",
      "title": "Id Prefix",
      "type": "string"
    },
    "priority": {
      "default": 0.5,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Priority",
      "type": "number"
    },
    "rationale": {
      "default": "",
      "title": "Rationale",
      "type": "string"
    },
    "reduces_uncertainty_on": {
      "items": {
        "type": "string"
      },
      "title": "Reduces Uncertainty On",
      "type": "array"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Contract schema version.",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "trust_label": {
      "$ref": "#/$defs/TrustLabel",
      "default": "PROPOSED"
    }
  },
  "required": [
    "assay_type"
  ],
  "title": "ExperimentProposal",
  "type": "object"
}