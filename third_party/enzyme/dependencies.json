{
  "schema_version": 1,
  "profile": "enzyme",
  "agent_dir": "agents/Enzyme-Agent",
  "contract": "Sources/weights are fetched by explicit install commands, not redistributed. check inspects paths and readiness records without loading models and never certifies scientific readiness.",
  "status_values": [
    "missing",
    "present_unvalidated"
  ],
  "components": [
    {
      "id": "peptide-runtime",
      "kind": "environment",
      "sources": [
        "agents/peptide-agent/requirements.txt"
      ],
      "required_paths": [
        {
          "path": "{peptide_python}",
          "kind": "executable"
        }
      ],
      "install_commands": [
        [
          "bash",
          "{peptide_agent}/install.sh"
        ]
      ],
      "limitations": "Shared base interpreter. File presence alone does not establish installed package compatibility."
    },
    {
      "id": "runtime",
      "kind": "environment",
      "sources": [
        "agents/Enzyme-Agent/requirements.txt",
        "agents/peptide-agent/requirements.txt"
      ],
      "requires": [
        "peptide-runtime"
      ],
      "required_paths": [
        {
          "path": "{python}",
          "kind": "executable"
        }
      ],
      "install_commands": [
        [
          "bash",
          "{agent}/scripts/bootstrap.sh",
          "--stage",
          "runtime"
        ]
      ],
      "layout": [
        "{data}/env/bin/python",
        "{data}/env/lib/python3.11/site-packages/"
      ]
    },
    {
      "id": "core",
      "kind": "installation_stage",
      "sources": [
        "agents/Enzyme-Agent/scripts/bootstrap.sh"
      ],
      "requires": [
        "peptide-runtime"
      ],
      "required_paths": [
        {
          "path": "{python}",
          "kind": "executable"
        },
        {
          "path": "{data}/models/ligandmpnn/manifest.json",
          "kind": "file"
        },
        {
          "path": "{data}/references/cf_dnase_reference.json",
          "kind": "file"
        }
      ],
      "install_commands": [
        [
          "bash",
          "{agent}/scripts/bootstrap.sh",
          "--stage",
          "core"
        ]
      ],
      "includes": [
        "qwen",
        "ligandmpnn",
        "proteinmpnn",
        "esm3",
        "zymctrl",
        "esmfold2",
        "dnase-reference"
      ]
    },
    {
      "id": "foundry",
      "kind": "installation_stage",
      "sources": [
        "agents/Enzyme-Agent/scripts/bootstrap_extended.sh",
        "https://github.com/RosettaCommons/foundry"
      ],
      "requires": [
        "runtime"
      ],
      "required_environment": [
        "ENZYME_FOUNDRY_BASE"
      ],
      "required_paths": [
        {
          "path": "{data}/foundry-env/bin/python",
          "kind": "executable"
        },
        {
          "path": "{data}/foundry-env/bin/rfd3",
          "kind": "executable"
        }
      ],
      "install_commands": [
        [
          "bash",
          "{agent}/scripts/bootstrap_extended.sh"
        ]
      ],
      "includes": [
        "rfdiffusion3",
        "thermompnn",
        "Python 3.12 Foundry environment"
      ],
      "limitations": "Requires a user-selected Python 3.12 CUDA Torch interpreter. Downloads extended sources/weights and installs pinned packages; does not create readiness evidence.",
      "readiness": [
        {
          "path": "{data}/models/rfdiffusion3/runtime-validation.json",
          "key": [
            "status"
          ],
          "equals": "passed"
        },
        {
          "path": "{data}/models/thermompnn/runtime-validation.json",
          "key": [
            "status"
          ],
          "equals": "passed"
        }
      ]
    },
    {
      "id": "qwen",
      "kind": "model",
      "sources": [
        "https://huggingface.co/Qwen/Qwen3.5-0.8B"
      ],
      "revision": "2fc06364715b967f1860aea9cf38778875588b17",
      "license": "Apache-2.0",
      "role": "planner",
      "requires": [
        "runtime"
      ],
      "required_paths": [
        {
          "path": "{qwen}/config.json",
          "kind": "file"
        },
        {
          "any_of": [
            "{qwen}/*.safetensors",
            "{qwen}/*.bin",
            "{qwen}/*.pth"
          ]
        }
      ],
      "install_commands": [
        [
          "{python}",
          "-m",
          "enzyme_agent.cli",
          "download",
          "qwen"
        ]
      ],
      "layout": [
        "{qwen}/{config,weights,manifest.json}"
      ]
    },
