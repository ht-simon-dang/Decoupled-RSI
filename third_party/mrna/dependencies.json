          "any_of": [
            "{qwen}/*.safetensors",
            "{qwen}/*.bin"
          ]
        }
      ],
      "install_commands": [
        [
          "{python}",
          "-c",
          "from huggingface_hub import snapshot_download; import sys; snapshot_download(sys.argv[1], revision=sys.argv[2], local_dir=sys.argv[3], ignore_patterns=[\"*.h5\",\"*.msgpack\",\"*.onnx\",\"*.ot\"])",
          "Qwen/Qwen3.5-0.8B",
          "2fc06364715b967f1860aea9cf38778875588b17",
