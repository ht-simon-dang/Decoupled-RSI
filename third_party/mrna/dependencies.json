{
  "schema_version": 1,
  "profile": "mrna",
  "agent_dir": "agents/mRNA-agent",
  "contract": "Sources/weights are fetched by explicit install commands, not redistributed. check inspects paths and readiness records without loading models and never certifies scientific readiness.",
  "status_values": [
    "missing",
    "present_unvalidated"
  ],
  "components": [
    {
      "id": "peptide-runtime",
      "kind": "environment",
      "sources": [
        "agents/peptide-agent/requirements.txt"
      ],
      "required_paths": [
        {
          "path": "{peptide_python}",
          "kind": "executable"
        }
      ],
      "install_commands": [
        [
          "bash",
          "{peptide_agent}/install.sh"
        ]
      ],
      "limitations": "Shared base interpreter. File presence alone does not establish installed package compatibility."
    },
    {
      "id": "runtime",
      "kind": "environment",
      "sources": [
        "agents/mRNA-agent/requirements.txt"
      ],
      "requires": [
        "peptide-runtime"
      ],
      "required_paths": [
        {
          "path": "{python}",
          "kind": "executable"
        }
      ],
      "install_commands": [
        [
          "{peptide_python}",
          "{agent}/scripts/bootstrap.py",
          "--stage",
          "runtime"
        ]
      ],
      "layout": [
        "{data}/venv/bin/python",
        "{data}/venv/lib/python3.11/site-packages/"
      ]
    },
    {
      "id": "core",
      "kind": "installation_stage",
      "sources": [
        "agents/mRNA-agent/scripts/bootstrap.py",
        "agents/mRNA-agent/scripts/fetch_assets.py"
      ],
      "requires": [
        "peptide-runtime"
      ],
      "required_paths": [
        {
          "path": "{python}",
          "kind": "executable"
        },
        {
          "path": "{data}/envs/gemorna/bin/python",
          "kind": "executable"
        },
        {
          "path": "{data}/assets.json",
          "kind": "file"
        },
        {
          "path": "{data}/external/LinearDesign/bin/LinearDesign_2D",
          "kind": "executable"
        }
      ],
      "install_commands": [
        [
          "{peptide_python}",
          "{agent}/scripts/bootstrap.py",
          "--stage",
          "core"
        ]
      ],
      "includes": [
        "gemorna",
        "lineardesign",
        "ribonn",
        "smart5utr",
        "parade",
        "optimus5",
        "references"
      ],
      "limitations": "This explicit grouped stage installs all core sources/assets and their Python 3.10 compatibility environment, not only one model."
    },
    {
      "id": "optional",
      "kind": "installation_stage",
      "sources": [
        "agents/mRNA-agent/scripts/bootstrap_optional.py",
        "agents/mRNA-agent/scripts/fetch_optional.py"
